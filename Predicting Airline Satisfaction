, X_valid.shape)\n\nprint(\"\\nSatisfied proportion:\")\nprint(\"Training:\", round(y_train.mean(), 4))\nprint(\"Validation:\", round(y_valid.mean(), 4))","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-31T22:42:46.042267Z","iopub.execute_input":"2026-10-31T22:42:46.043091Z","iopub.status.idle":"2026-10-31T22:42:46.590473Z","shell.execute_reply.started":"2026-10-31T22:42:46.043058Z","shell.execute_reply":"2026-10-31T22:42:46.589326Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"import pandas as pd\n\n# Copy to avoid changing the original split DataFrames\nX_train = X_train.copy()\nX_valid = X_valid.copy()\n\ncat_cols = [\"Gender\", \"Customer Type\", \"Type of Travel\", \"Class\"]\n\nfor col in cat_cols:\n    # Learn the available categories from training data only\n    categories = X_train[col].dropna().unique()\n    category_type = pd.CategoricalDtype(categories=categories)\n\n    # Apply the same category definitions to both datasets\n    X_train[col] = X_train[col].astype(category_type)\n    X_valid[col] = X_valid[col].astype(category_type)\n\nprint(X_train[cat_cols].dtypes)\n\nprint(\"\\nMissing values in training:\")\nprint(X_train.isna().sum()[X_train.isna().sum() > 0])","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-31T22:43:41.635843Z","iopub.execute_input":"2026-10-31T22:43:41.636946Z","iopub.status.idle":"2026-10-31T22:43:42.294974Z","shell.execute_reply.started":"2026-10-31T22:43:41.636903Z","shell.execute_reply":"2026-10-31T22:43:42.293661Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"import lightgbm as lgb\n\nmodel = lgb.LGBMClassifier(\n    objective=\"binary\",\n    metric=\"auc\",\n    n_estimators=2000,\n    learning_rate=0.05,\n    num_leaves=31,\n    random_state=42,\n    n_jobs=-1,\n    verbosity=-1\n)\n\nmodel.fit(\n    X_train,\n    y_train,\n    categorical_feature=cat_cols,\n    eval_set=[(X_valid, y_valid)],\n    callbacks=[\n        lgb.early_stopping(stopping_rounds=100),\n        lgb.log_evaluation(period=100)\n    ]\n)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-31T22:44:12.6121Z","iopub.execute_input":"2026-10-31T22:44:12.612623Z","iopub.status.idle":"2026-10-31T22:44:49.345224Z","shell.execute_reply.started":"2026-10-31T22:44:12.612592Z","shell.execute_reply":"2026-10-31T22:44:49.34424Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"from sklearn.metrics import roc_auc_score, log_loss\n\n# Probability of satisfaction = 1\ntrain_probs = model.predict_proba(\n    X_train, num_iteration=model.best_iteration_\n)[:, 1]\n\nvalid_probs = model.predict_proba(\n    X_valid, num_iteration=model.best_iteration_\n)[:, 1]\n\nresults = pd.DataFrame({\n    \"Dataset\": [\"Training\", \"Validation\"],\n    \"ROC AUC\": [\n        roc_auc_score(y_train, train_probs),\n        roc_auc_score(y_valid, valid_probs)\n    ],\n    \"Log loss\": [\n        log_loss(y_train, train_probs),\n        log_loss(y_valid, valid_probs)\n    ]\n})\n\nprint(results.round(6).to_string(index=False))","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-31T22:45:44.407002Z","iopub.execute_input":"2026-10-31T22:45:44.407955Z","iopub.status.idle":"2026-10-31T22:46:01.761496Z","shell.execute_reply.started":"2026-10-31T22:45:44.407907Z","shell.execute_reply":"2026-10-31T22:46:01.760112Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"import numpy as np\nfrom sklearn.metrics import log_loss\n\n# Every passenger receives the same probability\nbaseline_probs = np.full(len(y_valid), y_train.mean())\n\nbaseline_loss = log_loss(y_valid, baseline_probs)\nmodel_loss = log_loss(y_valid, valid_probs)\n\nprint(f\"Baseline log loss: {baseline_loss:.6f}\")\nprint(f\"Model log loss:    {model_loss:.6f}\")\nprint(f\"Reduction:        {(1 - model_loss / baseline_loss):.2%}\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-31T22:47:14.724222Z","iopub.execut